---
/**
 * ARQUIVO GERADO — não edite à mão.
 *
 * Saiu de `npm run compose`, que resolve a composição da biblioteca de seções e
 * grava `lp.manifest.json`. Para mudar a página, mude a composição:
 *
 *   npm run compose -- <slugs da composição nova>
 *
 * Header, Hero, Cotação e Footer são estrutura fixa do padrão (regra 13) e estão
 * fora da biblioteca. Os dois slots de shortcode saem de `site.ts`.
 *
 * Exceção desta LP (29/10/2026, docs/BRIEFING.md): o painel "identificar" (fase de
 * apoio) foi removido a pedido do cliente. Em 02/11/2026, "aplicacoes" deu lugar a
 * "segmentos" (ritmo `even`) e "perguntas" entrou na fase de autoridade. Em 03/11/2026,
 * "sistemas" (seção própria desta LP, móvel e fixo) entrou na oferta, antes de "linhas", e a LP
 * passou à estética da LP SEIVE LUB: respiro único (`uniform`) e fundos alternados seção a seção.
 * "clientes" (componente da LP SEIVE LUB) entrou depois de "segmentos".
 * O compositor recusa essa composição, por isso este arquivo e `lp.manifest.json`
 * foram ajustados à mão — não rode `npm run compose` sem reaplicar a exceção.
 */
import Layout from '../layouts/Layout.astro'
import Header from '../components/Header.astro'
import Hero from '../components/Hero.astro'
import QuoteForm from '../components/QuoteForm.astro'
import Footer from '../components/Footer.astro'
import SystemsSplit from '../components/sections/SystemsSplit.astro'
import ProductLines from '../components/sections/ProductLines.astro'
import SegmentsShowcase from '../components/sections/SegmentsShowcase.astro'
import ClientLogos from '../components/sections/ClientLogos.astro'
import Faq from '../components/sections/Faq.astro'
import WhyBrand from '../components/sections/WhyBrand.astro'
import { shortcodes } from '../data/site'
---

<Layout>
  <Header />

  <main id="main">
    <Hero>
      <Fragment slot="shortcode">{shortcodes.chat}</Fragment>
    </Hero>
    <SystemsSplit tone="light" rhythm="uniform" />
    <ProductLines tone="gray" rhythm="uniform" />
    <SegmentsShowcase tone="gray" rhythm="uniform" />
    <ClientLogos tone="light" rhythm="uniform" />
    <Faq tone="light" rhythm="uniform" />
    <WhyBrand tone="gray" rhythm="uniform" />
    <QuoteForm>
      <Fragment slot="shortcode">{shortcodes.form}</Fragment>
    </QuoteForm>
  </main>

  <Footer />
</Layout>
