---
/**
 * ESTRUTURA FIXA (PROMPT-PADRAO-LP 4.1.1). Barra navy sticky, logo em placa branca
 * "pendurada" (invade o hero), tagline central e CTA laranja. Sem menu e sem âncoras.
 */
import { Image } from 'astro:assets'
import seiveLogo from '../assets/seive-logo.webp'
import logo from '../assets/header-logo.png'
import { header, cta } from '../data/content'
---

<header class="sticky top-0 z-50 bg-primary-dark-900">
  <div class="mx-auto flex max-w-page items-center justify-between gap-3 px-4 py-3 sm:gap-6 sm:px-6 lg:px-10">
    <a href="/" class="flex shrink-0 items-center self-start">
      <span class="header-plate -mt-3 -mb-10 flex items-center gap-3 rounded-b-xl bg-neutral-light px-3 pt-5 pb-5 shadow-[0_10px_24px_-10px_rgba(0,0,0,0.55)] sm:gap-5 sm:px-6">
        <Image
          src={seiveLogo}
          alt="SEIVE"
          width={476}
          height={126}
          format="webp"
          loading="eager"
          fetchpriority="low"
          decoding="async"
          class="h-5 w-auto sm:h-10"
        />
        <span aria-hidden="true" class="h-6 w-px shrink-0 bg-ink/20 sm:h-9"></span>
        <Image
          src={logo}
          alt="Safe Mine"
          width={420}
          format="webp"
          loading="eager"
          fetchpriority="low"
          decoding="async"
          class="h-4 w-auto sm:h-8"
        />
      </span>
    </a>

    <span class="hidden flex-1 text-center font-display text-[15px] font-extrabold tracking-[0.14em] text-neutral-light uppercase sm:block lg:text-[17px]">
      {header.tagline}
    </span>

    <button
      type="button"
      data-cta="header-cta"
      class="btn-slave-whats inline-flex shrink-0 items-center bg-accent-orange px-4 py-2 font-sans text-[11px] font-bold uppercase tracking-[0.04em] text-neutral-light transition-colors duration-200 hover:bg-accent-orange-dark sm:px-6 sm:py-2.5 sm:text-[13px] sm:tracking-[0.06em]"
    >
      <span class="sm:hidden">{cta.primaryShort}</span>
      <span class="hidden sm:inline">{cta.primary}</span>
    </button>
  </div>
</header>
