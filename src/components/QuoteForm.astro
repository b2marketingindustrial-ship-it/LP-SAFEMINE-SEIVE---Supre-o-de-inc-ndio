---
/**
 * ESTRUTURA FIXA (PROMPT-PADRAO-LP 4.1.4). Grid 1.05fr · 1fr: formulário (shortcode) à esquerda, texto à direita.
 * Mobile: texto antes do formulário. O formulário é sempre o shortcode, nunca um <form> próprio.
 *
 * Nesta LP, o visual segue o mockup de 29/10/2026 (desvio registrado em docs/BRIEFING.md):
 * só o espaço do shortcode (sem card nem nota de LGPD, 03/11/2026), título com o produto em verde, botão de WhatsApp
 * verde e os 3 selos com ícone maior e divisórias. Grid, ordem e ritmo são os do padrão.
 */
import Eyebrow from './Eyebrow.astro'
import Button from './Button.astro'
import Icon from './Icon.astro'
import { quote, cta } from '../data/content'

const isDev = import.meta.env.DEV
const [titleStart, titleEnd = ''] = quote.title.split(quote.titleHighlight)
const hasHighlight = quote.title.includes(quote.titleHighlight)
---

<section id="cotacao" class="bg-neutral-gray-100 py-(--section-space)">
  <div class="mx-auto max-w-page px-6 lg:px-10">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,1fr)] lg:items-start lg:gap-16">
      {/* Coluna do formulário */}
      <div class="order-2 w-full lg:order-1">
        <div class="min-h-[400px] w-full">
          <slot name="shortcode">
            {isDev ? (
              <div
                class="flex min-h-[456px] w-full flex-col gap-3"
                aria-label="Mock do formulário (só em desenvolvimento)"
              >
                <span class="font-sans text-[11px] font-semibold tracking-[0.18em] text-accent-orange uppercase">
                  Mock · formulário
                </span>
                <div class="grid gap-3 sm:grid-cols-2">
                  <div class="h-11 rounded border border-neutral-gray-200/70 bg-neutral-gray-100" />
                  <div class="h-11 rounded border border-neutral-gray-200/70 bg-neutral-gray-100" />
                  <div class="h-11 rounded border border-neutral-gray-200/70 bg-neutral-gray-100" />
                  <div class="h-11 rounded border border-neutral-gray-200/70 bg-neutral-gray-100" />
                  <div class="h-28 rounded border border-neutral-gray-200/70 bg-neutral-gray-100 sm:col-span-2" />
                </div>
                <div class="mt-auto h-12 w-full rounded bg-accent-orange/80 sm:w-48" />
              </div>
            ) : (
              <div class="flex min-h-[456px] w-full flex-col items-center justify-center gap-3 rounded-xl border border-dashed border-primary-dark/25 p-8 text-center">
                <span class="font-sans text-[11px] font-semibold tracking-[0.18em] text-accent-orange uppercase">
                  Espaço reservado
                </span>
                <p class="font-display text-lg font-bold text-ink">
                  Shortcode — formulário de cotação
                </p>
              </div>
            )}
          </slot>
        </div>
      </div>

      {/* Coluna de texto */}
      <div class="order-1 lg:order-2">
        <Eyebrow>{quote.eyebrow}</Eyebrow>

        <h2 class="mt-4 font-display leading-[1.08] font-extrabold tracking-[-0.02em] text-primary-dark-900 text-[1.75rem] sm:text-[2.1rem] lg:text-[2.1rem] xl:text-[2.4rem]">
          {hasHighlight ? (
            <Fragment>
              {titleStart}
              <span class="block text-accent-orange">{quote.titleHighlight}</span>
              {titleEnd}
            </Fragment>
          ) : (
            quote.title
          )}
        </h2>

        <p class="mt-6 font-sans text-[16px] leading-relaxed text-ink-soft sm:text-[17px]">
          {quote.text}
        </p>

        <Button
          cta="cotacao-whatsapp"
          size="lg"
          iconName="whatsapp"
          iconPosition="left"
          class="mt-7"
        >
          {cta.whatsapp}
        </Button>

        <p class="mt-5 font-sans text-[15px] text-ink-soft sm:text-[16px]">{quote.help}</p>

        <ul
          class="mt-8 grid gap-5 sm:grid-cols-[minmax(0,1fr)_minmax(0,0.85fr)_minmax(0,1.25fr)] sm:gap-0"
          aria-label="Como é o atendimento"
        >
          {quote.trust.map((item) => (
            <li class="flex items-center gap-3 font-sans text-[15px] leading-snug text-ink sm:border-l sm:border-primary-dark/12 sm:px-5 sm:first:border-l-0 sm:first:pl-0 sm:last:pr-0">
              <Icon name={item.icon} class="size-8 shrink-0 text-accent-orange" />
              <span>{item.label}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  /* Base arredondada sobre o rodapé, que sobe por baixo dela (ver Footer.astro). Por CSS,
     e não por classe, para não mexer nas assinaturas que o check:lp confere. */
  #cotacao {
    position: relative;
    z-index: 1;
    border-bottom-left-radius: 2rem;
    border-bottom-right-radius: 2rem;
  }

  @media (min-width: 640px) {
    #cotacao {
      border-bottom-left-radius: 3rem;
      border-bottom-right-radius: 3rem;
    }
  }
</style>
