---
/**
 * Sistemas móvel e fixo — fase "oferta". Seção própria desta LP (03/11/2026,
 * docs/BRIEFING.md), logo depois do hero: apresenta os dois segmentos da supressão SEIVE
 * antes do kit, que detalha o sistema móvel.
 *
 * Dois cards lado a lado (empilhados no celular), na estética da LP SEIVE LUB (03/11/2026):
 * cards brancos com borda fina e `card-shadow`, foto grande com o chip do segmento e uma foto
 * de componente sobreposta ao canto, título, texto, 3 checks na placa cinza, as aplicações em
 * etiquetas e o CTA `sistemas-{id}`.
 */
import { Image } from 'astro:assets'
import Section from '@components/Section.astro'
import SplitHeader from '@components/SplitHeader.astro'
import Icon from '@components/Icon.astro'
import Button from '@components/Button.astro'
import type { SectionProps } from '@lib/layout'
import { cta } from '@data/content'
import { systems } from '@data/sections/sistemas'

type Props = SectionProps

const { tone, rhythm } = Astro.props
---

<Section id="sistemas" tone={tone} rhythm={rhythm}>
  <SplitHeader
    eyebrow={systems.eyebrow}
    title={systems.title}
    highlight={systems.titleHighlight}
    text={systems.text}
  />

  <ul class="mt-10 grid gap-6 lg:grid-cols-2 lg:gap-8">
    {systems.items.map((line) => (
      <li class="system-card group flex flex-col overflow-hidden rounded-2xl border border-primary-dark/10 bg-neutral-light card-shadow">
        {/* Foto principal com chip e detalhe sobreposto */}
        <div class="relative">
          <div class="aspect-[2/1] overflow-hidden">
            <Image
              src={line.photo.src}
              alt={line.photo.alt}
              format="webp"
              widths={[480, 720, 960, 1280]}
              sizes="(min-width: 1320px) 600px, (min-width: 1024px) 46vw, 100vw"
              loading="lazy"
              decoding="async"
              class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.03]"
            />
          </div>
          <span
            aria-hidden="true"
            class="absolute inset-x-0 top-0 h-24 bg-gradient-to-b from-primary-dark-900/55 to-transparent"
          />

          <span class="absolute top-5 left-5 inline-flex items-center gap-2.5 rounded-full bg-neutral-light/95 py-1.5 pr-4 pl-1.5 font-sans text-[12px] font-bold tracking-[0.14em] text-accent-orange uppercase shadow-[0_6px_14px_-8px_rgb(0_0_0/0.5)] sm:top-6 sm:left-6">
            <span class="flex size-8 items-center justify-center rounded-full bg-accent-orange text-neutral-light">
              <Icon name={line.icon} class="size-4" />
            </span>
            {line.tag}
          </span>

          <div class="absolute right-5 -bottom-8 w-24 overflow-hidden rounded-2xl bg-neutral-light p-1 shadow-[0_18px_36px_-18px_rgb(4_41_27/0.55)] sm:right-7 sm:w-28">
            <Image
              src={line.detail.src}
              alt={line.detail.alt}
              format="webp"
              width={224}
              loading="lazy"
              decoding="async"
              class="aspect-square w-full rounded-xl object-cover"
            />
          </div>
        </div>

        {/* Texto */}
        <div class="flex flex-1 flex-col p-6 sm:p-7">
          <h3 class="max-w-[calc(100%-6.5rem)] font-display text-[1.2rem] leading-tight font-extrabold text-primary-dark-900 sm:max-w-[calc(100%-8rem)] sm:text-[1.35rem]">
            {line.title}
          </h3>
          <p class="mt-2 font-sans text-[15px] leading-snug text-ink-soft">{line.description}</p>

          <ul class="mt-4 flex flex-wrap gap-x-5 gap-y-2">
            {line.features.map((feature) => (
              <li class="flex items-center gap-2 font-sans text-[14px] font-semibold text-ink">
                <Icon name="check" class="size-4 shrink-0 text-accent-orange" />
                {feature}
              </li>
            ))}
          </ul>

          <div class="mt-5 border-t border-primary-dark/10 pt-4">
            <p class="font-sans text-[11px] font-semibold tracking-[0.14em] text-ink-soft uppercase">
              {line.appliesTo}
            </p>
            <ul class="mt-2.5 flex flex-wrap gap-1.5">
              {line.applications.map((app) => (
                <li class="rounded-full bg-neutral-gray-100 px-3 py-1 font-sans text-[13px] font-semibold text-primary-dark-900">
                  {app}
                </li>
              ))}
            </ul>
          </div>

          <div class="mt-auto pt-5">
            <Button cta={`sistemas-${line.id}`} size="md" class="w-full sm:w-auto">
              {cta.card}
            </Button>
          </div>
        </div>
      </li>
    ))}
  </ul>
</Section>

<style>
  @media (prefers-reduced-motion: reduce) {
    .system-card img {
      transition: none !important;
    }
    .system-card:hover img {
      transform: none;
    }
  }
</style>
