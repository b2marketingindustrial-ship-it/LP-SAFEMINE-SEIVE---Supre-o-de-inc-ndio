---
/**
 * Linhas de produto — fase "oferta" da biblioteca B2. Nesta LP, os componentes do Kit de
 * Incêndio SEIVE (sistema móvel).
 *
 * Estética da LP SEIVE LUB (03/11/2026, pedido do usuário): cabeçalho em duas colunas
 * (SplitHeader), cards brancos com borda fina e `card-shadow`, foto no topo sobre a placa
 * clara (`surface-plate`) com o chip da função, título, descrição e os 3 checks. O item escuro
 * (`dark: true`) vira a faixa verde SEIVE de largura total abaixo dos cards, com o CTA
 * amarelo. Cada card claro é inteiro clicável por um botão sem texto que o cobre (rótulo
 * acessível em `aria-label`), para manter o `data-cta` por item.
 *
 * Atenção: `npm run compose` sobrescreve este arquivo com o da biblioteca. Para recompor a
 * LP sem perder o layout, restaure-o do git depois do compose.
 */
import Button from '@components/Button.astro'
import { Image } from 'astro:assets'
import Section from '@components/Section.astro'
import SplitHeader from '@components/SplitHeader.astro'
import Icon from '@components/Icon.astro'
import BrandCarousel from '@components/BrandCarousel.astro'
import type { SectionProps } from '@lib/layout'
import { cta } from '@data/content'
import { productLines } from '@data/sections/linhas'

type Props = SectionProps

const { tone, rhythm } = Astro.props
const cards = productLines.items.filter((line) => !line.dark)
const band = productLines.items.find((line) => line.dark)
---

<Section id="linhas" tone={tone} rhythm={rhythm}>
  <SplitHeader
    eyebrow={productLines.eyebrow}
    title={productLines.title}
    highlight={productLines.titleHighlight}
    text={productLines.text}
  />

  <BrandCarousel />

  <ul class="mt-10 grid gap-5 md:grid-cols-3">
    {cards.map((line) => (
      <li class="group relative flex flex-col overflow-hidden rounded-2xl border border-primary-dark/10 bg-neutral-light card-shadow transition-[transform,box-shadow] duration-300 ease-out hover:-translate-y-1 hover:card-shadow-hover motion-reduce:transition-none motion-reduce:hover:translate-y-0">
        <div class="surface-plate relative aspect-[4/3] overflow-hidden">
          <Image
            src={line.photo.src}
            alt={line.photo.alt}
            format="webp"
            width={640}
            loading="lazy"
            decoding="async"
            class="h-full w-full object-contain p-8 transition-transform duration-500 ease-out group-hover:scale-[1.05] motion-reduce:transition-none motion-reduce:group-hover:scale-100"
          />
          <span class="absolute inset-x-0 top-0 flex items-center p-4">
            <span class="rounded-full bg-neutral-light/95 px-3 py-1.5 font-sans text-[11px] font-bold tracking-[0.14em] text-accent-orange uppercase shadow-[0_6px_14px_-8px_rgb(0_0_0/0.5)]">
              {line.tag}
            </span>
          </span>
        </div>

        <div class="flex flex-1 flex-col p-5 sm:p-6">
          <h3 class="font-display text-[1.15rem] leading-tight font-extrabold text-primary-dark-900 sm:text-[1.25rem]">
            {line.title}
          </h3>
          <p class="mt-2 font-sans text-[15px] leading-snug text-ink-soft">{line.description}</p>

          <ul class="mt-5 divide-y divide-primary-dark/[0.08] rounded-lg bg-neutral-gray-100 px-3.5">
            {line.features.map((feature) => (
              <li class="flex items-center gap-2.5 py-2.5 font-sans text-[14.5px] font-semibold text-ink">
                <Icon name="check" class="size-4.5 shrink-0 text-accent-orange" />
                {feature}
              </li>
            ))}
          </ul>
        </div>

        {/* Card inteiro clicável: abre o atendimento com o rastreio do item */}
        <button
          type="button"
          data-cta={`linhas-${line.id}`}
          aria-label={`${cta.card}: ${line.title}`}
          class="btn-slave-whats absolute inset-0 z-[3] cursor-pointer rounded-2xl"
        />
      </li>
    ))}
  </ul>

  {/* Faixa verde de peças e suporte (o item escuro) */}
  {band && (
    <div class="navy-panel panel-shadow relative mt-6 grid items-center gap-6 overflow-hidden rounded-[1.5rem] px-6 py-8 sm:px-10 lg:grid-cols-[minmax(0,13rem)_minmax(0,1fr)_auto] lg:gap-0 lg:px-10 lg:py-7">
      <span class="blueprint-grid pointer-events-none absolute inset-0" aria-hidden="true"></span>

      <Image
        src={band.photo.src}
        alt={band.photo.alt}
        format="webp"
        width={640}
        loading="lazy"
        decoding="async"
        class="relative mx-auto h-36 w-auto object-contain sm:h-40 lg:mx-0 lg:h-36"
      />

      <div class="relative lg:border-l lg:border-white/15 lg:px-10">
        <p class="flex items-center gap-4 font-sans text-[12px] font-semibold tracking-[0.18em] text-neutral-light/75 uppercase sm:text-[13px]">
          <span aria-hidden="true" class="h-[3px] w-9 shrink-0 rounded-full bg-seive-yellow" />
          {band.tag}
        </p>
        <h3 class="mt-3 font-display text-[1.3rem] leading-tight font-extrabold text-neutral-light sm:text-[1.6rem]">
          {band.title}
        </h3>
        <p class="mt-2 font-sans text-[16px] text-neutral-light/75">{band.description}</p>
        <ul class="mt-4 flex flex-wrap gap-x-6 gap-y-2.5">
          {band.features.map((feature) => (
            <li class="flex items-center gap-2 font-sans text-[15px] whitespace-nowrap text-neutral-light/90">
              <Icon name="check" class="size-4.5 shrink-0 text-seive-yellow" />
              {feature}
            </li>
          ))}
        </ul>
      </div>

      <div class="relative lg:border-l lg:border-white/15 lg:pl-10">
        <Button cta={`linhas-${band.id}`} variant="yellow" size="md" class="w-full sm:w-auto">
          {cta.card}
        </Button>
      </div>
    </div>
  )}
</Section>
